# Application
APP_ENV=development
APP_VERSION=0.6.6

# Google Cloud and Gemini
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-east1
GEMINI_MODEL=your-approved-gemini-model

# Square checkout
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=replace-with-square-sandbox-token
SQUARE_LOCATION_ID=replace-with-square-sandbox-location-id

# Administrative notifications
ADMIN_NOTIFICATION_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM_EMAIL=notifications@example.com

# Durable lead storage
LEAD_STORAGE_ENABLED=true
FIRESTORE_DATABASE=(default)
FIRESTORE_LEADS_COLLECTION=sales_leads

# Customer journey telemetry
TELEMETRY_STORAGE_ENABLED=true
FIRESTORE_CONCIERGE_COLLECTION=ai_concierge_interactions
FIRESTORE_CONVERSION_COLLECTION=conversion_feedback
